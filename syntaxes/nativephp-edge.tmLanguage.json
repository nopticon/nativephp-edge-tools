{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NativePHP EDGE",
  "scopeName": "text.html.nativephp-edge",
  "injectionSelector": "L:text.html.blade, L:text.html.php",
  "patterns": [
    { "include": "#nativeTags" },
    { "include": "#bladeBindings" },
    { "include": "#nativeAttributes" }
  ],
  "repository": {
    "nativeTags": {
      "patterns": [{
        "match": "(?<=</?)(native:)([A-Za-z][A-Za-z0-9-]*)",
        "captures": {
          "1": { "name": "entity.name.tag.namespace.nativephp.edge" },
          "2": { "name": "entity.name.tag.nativephp.edge" }
        }
      }]
    },
    "bladeBindings": {
      "patterns": [{
        "match": "(?<=\\s)(@(?:press|change|input|focus|blur|submit)|:(?:[A-Za-z_][A-Za-z0-9_:-]*))(?=\\s*=)",
        "name": "entity.other.attribute-name.directive.nativephp.edge"
      }]
    },
    "nativeAttributes": {
      "patterns": [{
        "match": "(?<=\\s)(native:[A-Za-z_][A-Za-z0-9_:-]*|a11y-[A-Za-z0-9-]+)(?=\\s*=)",
        "name": "entity.other.attribute-name.nativephp.edge"
      }]
    }
  }
}
